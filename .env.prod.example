# ============================================================================
# 安心智能助手 V3 - 生产环境配置模板
# ============================================================================
# 使用说明：
#   1. 复制此文件为 .env：cp .env.prod.example .env
#   2. 填写所有必需配置（标记为 REQUIRED）
#   3. 可选配置保持默认值或根据需要修改
#
# 安全提醒：
#   - .env 文件包含敏感信息，已在 .gitignore 中排除
#   - 生产环境务必使用强密码和随机密钥
#   - 定期轮换密钥和密码
# ============================================================================

# ---------- 数据库配置 ----------
# REQUIRED: PostgreSQL 数据库密码（建议 16 位以上随机字符串）
POSTGRES_PASSWORD=your_strong_postgres_password_here

# ---------- 应用安全 ----------
# REQUIRED: JWT 密钥（用于生成访问令牌，建议 32 位以上随机字符串）
# 生成方式：openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_here

# REQUIRED: 管理员初始密码（首次部署后建议立即修改）
ADMIN_INITIAL_PASSWORD=Admin@2026

# ---------- AI 模型配置 ----------
# REQUIRED: OpenAI API Key（或兼容的 API Key）
OPENAI_API_KEY=sk-your-openai-api-key-here

# OPTIONAL: OpenAI API Base URL（使用第三方代理或自建 API 时填写）
OPENAI_BASE_URL=https://api.openai.com/v1

# OPTIONAL: 默认模型
OPENAI_MODEL=gpt-4-turbo-preview

# ---------- HTTPS 证书配置 ----------
# REQUIRED: 域名（用于 Let's Encrypt 证书申请）
DOMAIN=anxinai.com

# REQUIRED: Let's Encrypt 通知邮箱
LETSENCRYPT_EMAIL=admin@anxinai.com

# ---------- 第三方集成（可选） ----------
# E签宝配置
ESIGN_APP_ID=
ESIGN_SECRET=
ESIGN_SANDBOX=true

# 法大大配置
FADADA_APP_ID=
FADADA_SECRET=
FADADA_SANDBOX=true

# 微信支付配置
WECHAT_PAY_MCHID=
WECHAT_PAY_API_KEY=
WECHAT_PAY_CERT_PATH=/app/data/certs/wechat_pay_cert.pem

# 支付宝配置
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=/app/data/certs/alipay_private_key.pem
ALIPAY_PUBLIC_KEY_PATH=/app/data/certs/alipay_public_key.pem

# ---------- 运行时配置 ----------
# 运行模式（production / development / nas-lite）
RUNTIME_MODE=production

# CAPTCHA 开关（生产环境建议开启）
CAPTCHA_ENABLED=false

# CORS 允许的源（多个用逗号分隔）
CORS_ORIGINS=https://anxinai.com,https://www.anxinai.com

# ---------- 日志配置 ----------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------- 监控配置（可选） ----------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ---------- 镜像版本（可选，默认 latest） ----------
BACKEND_TAG=latest
FRONTEND_TAG=latest
