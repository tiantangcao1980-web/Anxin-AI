{
  "$schema": "https://anxin.local/schemas/external-resource-requirements.v1.json",
  "schema_version": 1,
  "last_updated": "2026-05-09",
  "status": "external_input_required",
  "storage_policy": {
    "secrets": "Store real secrets only in the approved secret manager or local untracked env files.",
    "certificates": "Store certificates and private-key files outside Git; commit only redacted artifact references.",
    "device_evidence": "Store screenshots, videos, provider logs, and device transcripts as redacted release artifacts.",
    "repository_rule": "Do not commit real API keys, private keys, account passwords, phone numbers, ID numbers, contract originals, access tokens, or session keys."
  },
  "required_documents": [
    "docs/release/external-inputs-checklist.md",
    "docs/release/external-resource-handoff.md",
    "docs/release/third-party-api-preparation.md",
    "docs/release/evidence-collection-runbook.md"
  ],
