{
  "name": "anxin-legal-miniprogram",
  "version": "1.0.0",
  "private": true,
  "description": "安心法务微信小程序",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "generate-icons": "node scripts/generate-icons.js",
    "prebuild:weapp": "npm run generate-icons",
    "build:weapp": "taro build --type weapp",
    "predev:weapp": "npm run generate-icons",
    "dev:weapp": "npm run build:weapp -- --watch",
    "prebuild:h5": "npm run generate-icons",
    "build:h5": "taro build --type h5",
    "postbuild:h5": "node scripts/check-bundle-size.js",
    "check-size": "node scripts/check-bundle-size.js",
    "predev:h5": "npm run generate-icons",
    "dev:h5": "npm run build:h5 -- --watch"
  },
  "dependencies": {
    "@tarojs/components": "3.6.x",
    "@tarojs/helper": "3.6.x",
    "@tarojs/plugin-framework-react": "3.6.x",
    "@tarojs/plugin-platform-weapp": "3.6.x",
    "@tarojs/plugin-platform-h5": "3.6.x",
    "@tarojs/react": "3.6.x",
    "@tarojs/runtime": "3.6.x",
    "@tarojs/shared": "3.6.x",
    "@tarojs/taro": "3.6.x",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@tarojs/plugin-html": "3.6.x"
  },
  "devDependencies": {
    "@babel/runtime": "^7.21.0",
    "@tarojs/cli": "3.6.x",
    "@tarojs/webpack5-runner": "3.6.x",
    "@types/react": "^18.2.0",
    "typescript": "^5.1.0",
    "sass": "^1.62.0",
    "babel-preset-taro": "3.6.x"
  }
}
