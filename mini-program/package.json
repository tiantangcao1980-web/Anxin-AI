{
  "name": "anxin-assistant-miniprogram",
  "version": "1.0.0",
  "private": true,
  "description": "安心智能助手微信小程序",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "generate-icons": "node scripts/generate-icons.js",
    "prebuild:weapp": "npm run generate-icons",
    "build:weapp": "taro build --type weapp",
    "predev:weapp": "npm run generate-icons",
    "dev:weapp": "npm run build:weapp -- --watch",
    "prebuild:h5": "npm run generate-icons",
    "build:h5": "taro build --type h5",
    "postbuild:h5": "node scripts/check-bundle-size.js",
    "check-size": "node scripts/check-bundle-size.js",
    "check-navigation-boundary": "node scripts/check-navigation-boundary.js",
    "check-privacy-boundary": "node scripts/check-privacy-boundary.js",
    "smoke:privacy": "node scripts/privacy-mode-smoke.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --skipLibCheck --noUnusedLocals false",
    "predev:h5": "npm run generate-icons",
    "dev:h5": "npm run build:h5 -- --watch"
  },
  "dependencies": {
    "@tarojs/components": "4.2.x",
    "@tarojs/helper": "4.2.x",
    "@tarojs/plugin-framework-react": "4.2.x",
    "@tarojs/plugin-html": "4.2.x",
    "@tarojs/plugin-platform-h5": "4.2.x",
    "@tarojs/plugin-platform-weapp": "4.2.x",
    "@tarojs/react": "4.2.x",
    "@tarojs/runtime": "4.2.x",
    "@tarojs/shared": "4.2.x",
    "@tarojs/taro": "4.2.x",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.28.5",
    "@babel/runtime": "^7.21.0",
    "@tarojs/cli": "4.2.x",
    "@tarojs/webpack5-runner": "4.2.x",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "babel-preset-taro": "4.2.x",
    "miniprogram-automator": "^0.12.1",
    "sass": "^1.62.0",
    "typescript": "^5.1.0",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "webpack": "5.89.0",
    "swiper": "^12.1.2",
    "lodash-es": "^4.17.23"
  }
}
