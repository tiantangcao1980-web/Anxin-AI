{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "安心法务",
  "version": "1.0.0",
  "identifier": "com.anxin.legal",
  "build": {
    "frontendDist": "../frontend/dist",
    "beforeBuildCommand": "cd ../frontend && npm run build",
    "beforeDevCommand": "cd ../frontend && npm run dev -- --port 3001"
  },
  "app": {
    "windows": [
      {
        "title": "安心法务",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "安心法务"
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* https://localhost:* ws://localhost:* wss://localhost:* https://*.anxin-legal.com wss://*.anxin-legal.com; img-src 'self' data: https://* blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-eval'; media-src 'self' blob: mediastream:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "certificateThumbprint": null,
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libssl3"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://api.anxin-legal.com/api/v1/updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": ""
    },
    "deep-link": {
      "desktop": {
        "schemes": ["anxin"]
      },
      "mobile": {
        "schemes": ["anxin"]
      }
    },
    "sql": {
      "preload": {
        "db": "sqlite:anxin_local.db"
      }
    }
  }
}
