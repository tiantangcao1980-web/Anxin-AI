# 安心法务 · NAS / Lite 部署 · 默认环境变量
#
# 配合 docker-compose.nas.yml 使用：
#   cp .env.nas.example .env
#   docker compose -f docker-compose.nas.yml up -d

# ===== 必填 =====
POSTGRES_PASSWORD=change_me_nas_pwd
REDIS_PASSWORD=change_me_redis_pwd

# 鉴权密钥（JWT）— 首次部署请用 `openssl rand -base64 48` 生成
JWT_SECRET=change_me_jwt_48_chars_base64

# 运行模式：nas-lite / hybrid / cloud
RUNTIME_MODE=nas-lite

# ===== 大模型（至少配一个） =====
# 推荐本地部署 Ollama + Qwen/DeepSeek
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 本地 Ollama（需先在宿主机安装 ollama 并拉取模型）
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b

# ===== 安全选项（NAS 自托管默认可关） =====
CAPTCHA_ENABLED=false

# ===== 镜像 tag（可选） =====
BACKEND_TAG=latest
FRONTEND_TAG=latest

# ===== 多模态能力开关（NAS Lite 默认关闭） =====
NEO4J_ENABLED=false
LIVEKIT_ENABLED=false
SEARXNG_ENABLED=false
