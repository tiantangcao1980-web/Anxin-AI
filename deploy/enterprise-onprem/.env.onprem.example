# =====================================================================
# 企业私有化部署 .env 模板
# 使用前：cp .env.onprem.example ../../.env，然后逐项填写
# =====================================================================

# ---------- 基础 ----------
ENVIRONMENT=production
DEV_MODE=false
BACKEND_TAG=latest

# ---------- 强密码（部署前必改） ----------
POSTGRES_PASSWORD=please-change-me-strong
REDIS_PASSWORD=please-change-me-strong
MINIO_ROOT_USER=anxin-admin
MINIO_ROOT_PASSWORD=please-change-me-strong
SECRET_KEY=please-change-me-32-bytes-random
JWT_SECRET=please-change-me-32-bytes-random

# ---------- LLM（私有化通常用本地推理或客户自有 endpoint） ----------
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://your-local-llm.example/v1
LLM_API_KEY=
LLM_MODEL=Qwen2.5-72B-Instruct

# ---------- Skill 沙箱签名公钥 ----------
# 多个发布方用逗号分隔：publisher_a=base64key1,publisher_b=base64key2
SKILL_SANDBOX_PUBLISHER_KEYS=

# ---------- LDAP / AD 同步（可选） ----------
LDAP_URL=ldap://ad.corp.example:389
LDAP_BIND_DN=CN=anxin-sync,OU=ServiceAccounts,DC=corp,DC=example
LDAP_BIND_PASSWORD=
LDAP_USER_BASE_DN=OU=Users,DC=corp,DC=example
LDAP_DEPT_BASE_DN=OU=Departments,DC=corp,DC=example
LDAP_SYNC_INTERVAL_SEC=300

# ---------- 离线 / 断网 ----------
# 启用时跳过外部更新检查、Sentry、远端遥测
AIRGAP=false
SENTRY_DSN=

# ---------- 强制安全开关 ----------
AUTH_REDIS_FAIL_CLOSED=true
CAPTCHA_ENABLED=true
RATE_LIMIT_FAIL_CLOSED=true
