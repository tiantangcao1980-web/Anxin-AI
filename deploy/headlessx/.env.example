# HeadlessX 部署配置 — 复制为 .env 并按实际填写
# cp .env.example .env

# ============ 鉴权 ============
# 与后端 backend/.env 中的 HEADLESSX_API_KEY 完全一致
# 推荐：openssl rand -hex 32
HEADLESSX_API_KEY=please-generate-32byte-hex-key

# ============ 端口 ============
# 容器内固定 3000；本机暴露端口可改
HEADLESSX_PORT=3000

# ============ 并发 / 性能 ============
# 单实例并发渲染数。每页 ~500MB-1GB 内存。3 并发约占 3-4G。
HEADLESSX_MAX_CONCURRENT=3
# 单次渲染默认超时 (毫秒)
HEADLESSX_DEFAULT_TIMEOUT_MS=30000

# ============ Camoufox 浏览器配置 ============
# 模拟地区（影响时区/语言/字体）
CAMOUFOX_LOCALE=zh-CN
# 是否启用 GeoIP（按 proxy IP 自动匹配地理位置指纹）
CAMOUFOX_GEOIP=true

# ============ 数据层密码 ============
# Postgres 密码（仅内部使用，不暴露）
HEADLESSX_DB_PASSWORD=please-change-me

# ============ 网络 ============
# 主项目 docker network 名（让 backend 能 resolve `http://headlessx:3000`）
# 与 docker-compose.yml 中 networks 字段一致；常见为 `anxin-net` 或 `<project>_default`
MAIN_NETWORK_NAME=anxin-net
