# 安心 V3 可观测性 stack - 环境变量样例
# cp .env.example .env  然后填入真实值

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=请改为强口令至少20位
GRAFANA_ROOT_URL=https://grafana.anxinagent.com

# Postgres Exporter DSN (注意 sslmode 与生产保持一致)
POSTGRES_EXPORTER_DSN=postgres://exporter:exporter_password@host.docker.internal:5432/anxin_v3?sslmode=disable

# Redis
REDIS_ADDR=redis://host.docker.internal:6379
REDIS_PASSWORD=

# 部署环境
ENV=production
