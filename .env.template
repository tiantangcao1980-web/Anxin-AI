# ============================================================
# 安心法务 - 私有化部署环境配置模板
# ============================================================
# 使用说明:
#   1. 复制此文件: cp .env.template .env
#   2. 按需修改各项配置（标注 [必填] 的项必须修改）
#   3. 启动服务: make init 或 make up
#
# 注意: .env 文件已加入 .gitignore，不会提交到版本库
# ============================================================

# ==================== 基础配置 ====================

# 运行环境：development（开发）| staging（预发布）| production（生产）
ENVIRONMENT=development

# 调试模式（生产环境务必设为 false）
DEBUG=false

# 开发模式：启用后跳过认证，仅限开发环境使用
# 生产环境必须为 false，否则服务拒绝启动
DEV_MODE=false

# 服务端口
BACKEND_PORT=8001
FRONTEND_PORT=80

# CORS 允许的前端域名（多个用逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==================== 安全配置 ====================

# [必填-生产环境] JWT 认证密钥
# 生成方式: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=your-super-secret-jwt-key-please-change-in-production
JWT_ALGORITHM=HS256
# Token 有效期（分钟），默认 24 小时
JWT_EXPIRE_MINUTES=1440

# 管理员初始密码（首次启动时创建管理员账户）
# 不设置则自动生成随机密码（仅在日志中显示一次）
# ADMIN_INITIAL_PASSWORD=your-secure-password-here

# 敏感数据加密密钥（用于加密存储在数据库中的 API 密钥等）
# 生成方式: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# LLM_ENCRYPTION_KEY=your-fernet-key-here

# ==================== LLM 大模型配置 ====================

# [必填] LLM 提供商
# 支持: openai, anthropic, deepseek, qwen, glm, minimax, moonshot,
#       baichuan, sparkdesk, ernie, hunyuan, doubao, stepfun, yi,
#       ollama, localai, vllm, xinference, llamacpp, custom
LLM_PROVIDER=qwen

# [必填] LLM API 密钥
LLM_API_KEY=sk-your-api-key-here

# LLM API 地址（根据提供商填写）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 使用的模型名称
LLM_MODEL=qwen-max

# 生成温度（0.0-1.0，越高越随机）
LLM_TEMPERATURE=0.7

# 最大生成 Token 数
LLM_MAX_TOKENS=4096

# ==================== Embedding 向量化配置 ====================

# Embedding API 密钥（如与 LLM 相同可不填）
EMBEDDING_API_KEY=sk-your-embedding-key-here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024

# 是否使用本地 Embedding 模型（无需 API 调用，但需要 GPU）
USE_LOCAL_EMBEDDING=false
LOCAL_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# ==================== 数据库配置 ====================

# PostgreSQL 连接地址
# Docker 内部使用: postgresql://postgres:password@postgres:5432/legal_agent_db
# 本地开发使用:    postgresql://postgres:password@localhost:5433/legal_agent_db
DATABASE_URL=postgresql://postgres:password@localhost:5433/legal_agent_db
DATABASE_POOL_SIZE=10

# Redis 缓存地址
REDIS_URL=redis://localhost:6379/0

# ==================== 向量数据库配置 ====================

# Qdrant 向量数据库
QDRANT_URL=http://localhost:6333
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=legal_knowledge

# RAG 检索参数
RAG_TOP_K=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_SCORE_THRESHOLD=0.5
RAG_CONTEXT_MAX_LENGTH=4000

# ==================== 图数据库配置 ====================

# Neo4j 知识图谱
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ==================== 对象存储配置 ====================

# MinIO 文件存储
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password
MINIO_BUCKET=legal-documents

# ==================== 搜索服务配置 ====================

SEARCH_PROVIDER=perplexity
SEARCH_API_KEY=your-search-api-key

# ==================== 日志配置 ====================

# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# 日志格式: json（结构化）| text（可读）
LOG_FORMAT=json

# ==================== 品牌定制 ====================
# 私有化部署时可自定义品牌信息

# 系统名称（显示在页面标题、登录页等位置）
BRAND_NAME=安心法务

# 品牌 Logo URL（留空使用默认 Logo）
BRAND_LOGO_URL=

# 品牌主色调（CSS 颜色值）
BRAND_PRIMARY_COLOR=#D4A574

# 品牌 Favicon URL（留空使用默认图标）
BRAND_FAVICON_URL=

# ==================== 第三方登录（可选） ====================

# 微信登录
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# WECHAT_REDIRECT_URI=

# 支付宝登录
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_REDIRECT_URI=

# 前端登录页 URL（OAuth 回调后重定向）
FRONTEND_LOGIN_URL=http://localhost:3001/login

# ==================== 第三方 API（可选） ====================

# 企查查 API（用于尽职调查）
# QICHACHA_API_KEY=your-qichacha-api-key

# 天眼查 API（用于企业信息查询）
# TIANYANCHA_API_KEY=your-tianyancha-api-key
