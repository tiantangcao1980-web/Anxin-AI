# ─────────────────────────────────────────
# 安心智能助手 Web 前端环境变量示例（V3）
# ─────────────────────────────────────────

# 后端 API base
VITE_API_BASE_URL=/api

# ─── P19-B 可观测层（Sentry / Web Vitals） ───
# DSN 留空则前端监控自动关闭（开发态默认行为）
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
# 0.0 ~ 1.0，生产建议 0.1
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Session Replay 采样率，生产建议 0.1，错误时强制 1.0
VITE_SENTRY_REPLAYS_SAMPLE_RATE=0.1
