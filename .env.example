# ============================================================
# AI法务智能体系统 - 环境配置模板
# ============================================================
# 使用说明:
# 1. 复制此文件为 .env:  cp .env.example .env
# 2. 填写必要的API密钥和配置
# 3. 启动服务
#
# ⚠️ 注意：.env 文件已加入 .gitignore，不会提交到 Git
# ============================================================

# ============ 基础配置 ============
# 环境标识：development | staging | production
ENVIRONMENT=development
DEBUG=false
# 开发模式（跳过认证等，生产环境必须为 false）
DEV_MODE=false

# CORS 允许的前端源（多个用逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============ 管理员初始密码 ============
# 首次启动时创建的管理员账户密码
# 不设置则自动生成随机密码（仅在日志中显示一次）
# ADMIN_INITIAL_PASSWORD=your-secure-password-here

# ============ LLM配置 ============
# 默认LLM配置 (可通过LLM管理页面在数据库中覆盖)
# 支持的提供商: openai, anthropic, deepseek, qwen, glm, minimax, moonshot,
#              baichuan, sparkdesk, ernie, hunyuan, doubao, stepfun, yi,
#              ollama, localai, vllm, xinference, llamacpp, custom
LLM_PROVIDER=qwen
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-max
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# Embedding 配置
EMBEDDING_API_KEY=sk-your-embedding-key-here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024

# LLM加密密钥 (用于加密存储在数据库中的API密钥)
# 生产环境必须设置固定密钥，否则重启后无法解密已保存的密钥
# 生成方式: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# LLM_ENCRYPTION_KEY=your-fernet-key-here

# 是否使用本地Embedding模型
USE_LOCAL_EMBEDDING=false
LOCAL_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# ============ 数据库配置 ============
# PostgreSQL
DATABASE_URL=postgresql://postgres:your-strong-password@localhost:5433/legal_agent_db
DATABASE_POOL_SIZE=10

# Redis缓存
REDIS_URL=redis://localhost:6379/0

# ============ 向量数据库配置 ============
QDRANT_URL=http://localhost:6333
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=legal_knowledge

# RAG检索配置
RAG_TOP_K=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_SCORE_THRESHOLD=0.5
RAG_CONTEXT_MAX_LENGTH=4000

# Neo4j图数据库
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-strong-password

# ============ 对象存储配置 ============
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=your-strong-password
MINIO_BUCKET=legal-documents

# ============ 安全配置 ============
# JWT认证密钥 (生产环境必须更换！)
# 生成方式: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=your-super-secret-jwt-key-please-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ============ 搜索服务配置 ============
SEARCH_PROVIDER=perplexity
SEARCH_API_KEY=your-search-api-key

# ============ 日志配置 ============
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============ 服务端口 ============
BACKEND_PORT=8001
FRONTEND_PORT=80

# ============ 第三方API (可选) ============
# 企查查API (用于尽职调查)
# QICHACHA_API_KEY=your-qichacha-api-key
# 天眼查API (用于企业信息查询)
# TIANYANCHA_API_KEY=your-tianyancha-api-key
# 爱企查API
# AIQICHA_API_KEY=your-aiqicha-api-key
# 信用中国API
# CREDIT_CHINA_API_KEY=your-credit-china-api-key

# ============ 法律数据采集配置 ============
# 数据存储目录 (相对于 backend/)
DATA_DIR=data
# 采集器请求间隔(秒)，防止被封IP
COLLECTOR_RATE_LIMIT=2.0
COLLECTOR_MAX_RETRIES=3
COLLECTOR_REQUEST_TIMEOUT=30
COLLECTOR_MAX_CONCURRENT=3
