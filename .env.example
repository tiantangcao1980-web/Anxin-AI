# ============================================================
# AI法务智能体系统 - 环境配置模板
# ============================================================
# 使用说明:
# 1. 复制此文件为 .env:  cp .env.example .env
# 2. 填写必要的API密钥和配置
# 3. 启动服务
#
# ⚠️ 注意：.env 文件已加入 .gitignore，不会提交到 Git
# ============================================================

# ============ 基础配置 ============
# 环境标识：development | staging | production
ENVIRONMENT=development
DEBUG=false
# 开发模式（跳过认证等，生产环境必须为 false）
DEV_MODE=false

# CORS 允许的前端源（多个用逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============ 管理员初始密码 ============
# 首次启动时创建的管理员账户密码
# 不设置则自动生成随机密码（仅在日志中显示一次）
# ADMIN_INITIAL_PASSWORD=your-secure-password-here

# ============ LLM配置 ============
# 默认LLM配置 (可通过LLM管理页面在数据库中覆盖)
# 支持的提供商: openai, anthropic, deepseek, qwen, glm, minimax, moonshot,
#              baichuan, sparkdesk, ernie, hunyuan, doubao, stepfun, yi,
#              ollama, localai, vllm, xinference, llamacpp, custom
LLM_PROVIDER=qwen
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-max
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# Embedding 配置
EMBEDDING_API_KEY=sk-your-embedding-key-here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024

# GitNexus 知识图 embeddings（仅用于代码索引语义搜索，不等同于业务 RAG）
# 启用前需要一个 OpenAI-compatible /v1/embeddings endpoint。
# scripts/gitnexus-index.sh --embeddings 会优先读取 GITNEXUS_*；
# 如果未设置，会自动复用上面的 EMBEDDING_BASE_URL/MODEL/DIMENSIONS/API_KEY。
# 注意：GITNEXUS_EMBEDDING_URL 填 /v1 base URL，不要包含 /embeddings。
# GITNEXUS_EMBEDDING_URL=http://127.0.0.1:8080/v1
# GITNEXUS_EMBEDDING_MODEL=snowflake-arctic-embed-xs
# GITNEXUS_EMBEDDING_DIMS=384
# GITNEXUS_EMBEDDING_API_KEY=unused

# LLM加密密钥 (用于加密存储在数据库中的API密钥)
# 生产环境必须设置固定密钥，否则重启后无法解密已保存的密钥
# 生成方式: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# LLM_ENCRYPTION_KEY=your-fernet-key-here

# 是否使用本地Embedding模型
USE_LOCAL_EMBEDDING=false
LOCAL_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# ============ 数据库配置 ============
# PostgreSQL
DATABASE_URL=postgresql://postgres:your-strong-password@localhost:5433/legal_agent_db
DATABASE_POOL_SIZE=10

# Redis缓存
REDIS_URL=redis://localhost:6379/0

# ============ 向量数据库配置 ============
QDRANT_URL=http://localhost:6333
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=legal_knowledge

# RAG检索配置
RAG_TOP_K=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_SCORE_THRESHOLD=0.5
RAG_CONTEXT_MAX_LENGTH=4000

# Neo4j图数据库
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-strong-password

# ============ 对象存储配置 ============
STORAGE_BACKEND=minio
STORAGE_LOCAL_PATH=data/storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=your-strong-password
MINIO_BUCKET=legal-documents

# Webhook 自动重试（生产/预发建议启用）
WEBHOOK_RETRY_WORKER_ENABLED=false
WEBHOOK_RETRY_INTERVAL_SECONDS=60
WEBHOOK_RETRY_BATCH_SIZE=20
WEBHOOK_RETRY_MAX_ATTEMPTS=5
WEBHOOK_RETRY_BASE_DELAY_SECONDS=60
WEBHOOK_RETRY_MAX_DELAY_SECONDS=3600

# 微信支付 v3 官方回调验签（接入沙箱/生产商户后启用）
OAUTH_WECHAT_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=

PAYMENT_NOTIFY_BASE_URL=https://api.your-domain.com
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_MERCHANT_PRIVATE_KEY_PATH=
WECHAT_PAY_MERCHANT_PRIVATE_KEY=
WECHAT_PAY_API_BASE_URL=https://api.mch.weixin.qq.com
WECHAT_PAY_OFFICIAL_WEBHOOK_ENABLED=false
# 微信同步 API 响应验签与官方回调验签共用；启用 wechat_pay provider 时必须配置。
WECHAT_PAY_PLATFORM_SERIAL=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_API_V3_KEY=

# 支付宝官方异步通知 RSA2 验签（接入沙箱/生产应用后启用）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PRIVATE_KEY=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
ALIPAY_OFFICIAL_WEBHOOK_ENABLED=false
# 支付宝 query/refund/close 同步响应验签与官方异步通知验签共用。
ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_PUBLIC_KEY=

# e签宝官方回调 HMAC-SHA256 验签（接入沙箱/生产应用后启用）
ESIGN_PROVIDER=mock
ESIGN_BAO_APP_ID=
ESIGN_BAO_APP_SECRET=
ESIGN_BAO_API_URL=https://smlopenapi.esign.cn
ESIGN_BAO_CREATE_FLOW_PATH=/api/v2/signflows/createFlowOneStep
ESIGN_BAO_START_FLOW_PATH=/v1/signflows/{flow_id}/start
ESIGN_BAO_SIGN_URL_PATH=/v1/signflows/{flow_id}/executeUrl
ESIGN_BAO_STATUS_PATH=/v1/signflows/{flow_id}
ESIGN_BAO_DOWNLOAD_PATH=/v1/signflows/{flow_id}/documents
ESIGN_BAO_CANCEL_PATH=/v1/signflows/{flow_id}/revoke
FADADA_APP_ID=
FADADA_APP_SECRET=
FADADA_API_URL=https://api.fadada.com/api/v5
FADADA_ACCESS_TOKEN=
FADADA_ACCESS_TOKEN_PATH=/service/get-access-token
FADADA_CREATE_TASK_PATH=/sign-task/create
FADADA_SIGN_URL_PATH=/sign-task/actor/get-url
FADADA_STATUS_PATH=/sign-task/app/get-detail
FADADA_DOWNLOAD_URL_PATH=/sign-task/owner/get-download-url
FADADA_CANCEL_PATH=/sign-task/cancel
ESIGN_OFFICIAL_WEBHOOK_ENABLED=false
# 通用 HMAC 回归路径使用；官方模式开启后使用 ESIGN_BAO_APP_SECRET 或 FADADA_APP_SECRET。
ESIGN_WEBHOOK_SECRET=

# ============ 安全配置 ============
# JWT认证密钥 (生产环境必须更换！)
# 生成方式: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=your-super-secret-jwt-key-please-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ============ 搜索服务配置 ============
SEARCH_PROVIDER=perplexity
SEARCH_API_KEY=your-search-api-key

# ============ 日志配置 ============
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============ 服务端口 ============
BACKEND_PORT=8001
FRONTEND_PORT=80

# ============ 第三方API (可选) ============
# 企查查API (用于尽职调查)
# QICHACHA_API_KEY=your-qichacha-api-key
# 天眼查API (用于企业信息查询)
# TIANYANCHA_API_KEY=your-tianyancha-api-key
# 爱企查API
# AIQICHA_API_KEY=your-aiqicha-api-key
# 信用中国API
# CREDIT_CHINA_API_KEY=your-credit-china-api-key

# ============ 法律数据采集配置 ============
# 数据存储目录 (相对于 backend/)
DATA_DIR=data
# 采集器请求间隔(秒)，防止被封IP
COLLECTOR_RATE_LIMIT=2.0
COLLECTOR_MAX_RETRIES=3
COLLECTOR_REQUEST_TIMEOUT=30
COLLECTOR_MAX_CONCURRENT=3
