# ===== 安心AI法务 — 环境变量配置模板 =====
# 复制此文件为 .env 并填写实际值
# 注意：.env 文件不要提交到版本控制

DEBUG=false
DEV_MODE=false
ADMIN_INITIAL_PASSWORD=请修改为强密码
BACKEND_PORT=8001
FRONTEND_PORT=3001

# ===== LLM 配置 =====
# 通义千问 DashScope
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
OPENAI_API_KEY=your-api-key-here
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Embedding 配置
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024

# ===== 数据库 =====
DATABASE_URL=postgresql://postgres:your-password@localhost:5433/legal_agent_db
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=your-password

# ===== 安全 =====
JWT_SECRET_KEY=请使用openssl rand -base64 32生成
LLM_ENCRYPTION_KEY=请使用python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"生成

# ===== 第三方服务（按需配置） =====
# 阿里云邮件
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# ALIYUN_EMAIL_SENDER=

# LiveKit 音视频
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# 电子签名（选择其一）
# ESIGN_PROVIDER=esignbao
# ESIGN_BAO_APP_ID=
# ESIGN_BAO_APP_SECRET=

# 支付（按需启用）
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_API_KEY=
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
