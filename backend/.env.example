# ===== 安心AI法务 — 环境变量配置模板 =====
# 复制此文件为 .env 并填写实际值
# 注意：.env 文件不要提交到版本控制

DEBUG=false
DEV_MODE=false
ADMIN_INITIAL_PASSWORD=请修改为强密码
BACKEND_PORT=8001
FRONTEND_PORT=3001

# ===== LLM 配置 =====
# 通义千问 DashScope
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
OPENAI_API_KEY=your-api-key-here
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Embedding 配置
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024

# ===== 数据库 =====
DATABASE_URL=postgresql://postgres:your-password@localhost:5433/legal_agent_db
REDIS_URL=redis://localhost:6379/0
CONTRACT_REVIEW_TIMEOUT_SECONDS=90
CONTRACT_REVIEW_LOCK_TTL_SECONDS=150
CONTRACT_REVIEW_LOCK_BACKEND=auto
AUTH_REDIS_FAIL_CLOSED=true
AUTH_REFRESH_BODY_COMPAT_ENABLED=false
QDRANT_URL=http://localhost:6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=data/storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=your-password

# Webhook 自动重试（生产/预发建议启用）
WEBHOOK_RETRY_WORKER_ENABLED=false
WEBHOOK_RETRY_INTERVAL_SECONDS=60
WEBHOOK_RETRY_BATCH_SIZE=20
WEBHOOK_RETRY_MAX_ATTEMPTS=5
WEBHOOK_RETRY_BASE_DELAY_SECONDS=60
WEBHOOK_RETRY_MAX_DELAY_SECONDS=3600
WEBHOOK_PROCESSING_LOCK_TTL_SECONDS=30
WEBHOOK_PROCESSING_LOCK_WAIT_SECONDS=5
WEBHOOK_PROCESSING_LOCK_BACKEND=auto

# ===== 安全 =====
JWT_SECRET_KEY=请使用openssl rand -base64 32生成
LLM_ENCRYPTION_KEY=请使用python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"生成

# ===== MCP 外部工具连接治理 =====
# 商业环境中独立 MCP Server 默认关闭；统一走带 RBAC/审计的 /api/v1/mcp。
MCP_STANDALONE_ENABLED=false
# stdio MCP 商业环境默认关闭；启用后仍必须配置命令与命令行 allowlist。
MCP_STDIO_ENABLED=false
# list 类型使用 JSON 数组；带 args 的 stdio 必须精确匹配完整 command line。
MCP_STDIO_ALLOWED_COMMANDS=[]
MCP_STDIO_ALLOWED_COMMAND_LINES=[]
MCP_STDIO_ALLOWED_ENV_KEYS=[]
MCP_SSE_ALLOWED_HOSTS=[]
MCP_SSE_ALLOWED_SCHEMES=["https"]
# staging/production 默认要求 MCP 工具调用携带 DB-backed route token；此开关用于开发/测试提前演练。
MCP_TOOL_ROUTE_TOKEN_REQUIRED=false
# staging/production 默认要求 CLI /execute 携带 DB-backed route token；此开关用于开发/测试提前演练。
CLI_ROUTE_TOKEN_REQUIRED=false
# staging/production 默认要求 LLM runtime 调用携带 DB-backed route token；此开关用于开发/测试提前演练。
LLM_ROUTE_TOKEN_REQUIRED=false
# staging/production 默认要求浏览器/爬虫 fetch 携带 DB-backed route token；此开关用于开发/测试提前演练。
BROWSER_FETCH_ROUTE_TOKEN_REQUIRED=false

# ===== 第三方服务（按需配置） =====
# 阿里云邮件
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# ALIYUN_EMAIL_SENDER=

# LiveKit 音视频
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# 电子签名（选择其一；真实密钥只写入本地 .env 或 secret manager）
ESIGN_PROVIDER=mock
ESIGN_BAO_APP_ID=
ESIGN_BAO_APP_SECRET=
ESIGN_BAO_API_URL=https://smlopenapi.esign.cn
ESIGN_BAO_CREATE_FLOW_PATH=/api/v2/signflows/createFlowOneStep
ESIGN_BAO_START_FLOW_PATH=/v1/signflows/{flow_id}/start
ESIGN_BAO_SIGN_URL_PATH=/v1/signflows/{flow_id}/executeUrl
ESIGN_BAO_STATUS_PATH=/v1/signflows/{flow_id}
ESIGN_BAO_DOWNLOAD_PATH=/v1/signflows/{flow_id}/documents
ESIGN_BAO_CANCEL_PATH=/v1/signflows/{flow_id}/revoke
FADADA_APP_ID=
FADADA_APP_SECRET=
FADADA_API_URL=https://api.fadada.com/api/v5
FADADA_ACCESS_TOKEN=
FADADA_ACCESS_TOKEN_PATH=/service/get-access-token
FADADA_CREATE_TASK_PATH=/sign-task/create
FADADA_SIGN_URL_PATH=/sign-task/actor/get-url
FADADA_STATUS_PATH=/sign-task/app/get-detail
FADADA_DOWNLOAD_URL_PATH=/sign-task/owner/get-download-url
FADADA_CANCEL_PATH=/sign-task/cancel
ESIGN_OFFICIAL_WEBHOOK_ENABLED=false
ESIGN_WEBHOOK_SECRET=

# 支付（按需启用）
OAUTH_WECHAT_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=

PAYMENT_NOTIFY_BASE_URL=https://api.your-domain.com
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_MERCHANT_PRIVATE_KEY_PATH=
WECHAT_PAY_MERCHANT_PRIVATE_KEY=
WECHAT_PAY_API_BASE_URL=https://api.mch.weixin.qq.com
WECHAT_PAY_OFFICIAL_WEBHOOK_ENABLED=false
# 微信同步 API 响应验签与官方回调验签共用；启用 wechat_pay provider 时必须配置。
WECHAT_PAY_PLATFORM_SERIAL=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_API_V3_KEY=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PRIVATE_KEY=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
ALIPAY_OFFICIAL_WEBHOOK_ENABLED=false
# 支付宝 query/refund/close 同步响应验签与官方异步通知验签共用。
ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_PUBLIC_KEY=
