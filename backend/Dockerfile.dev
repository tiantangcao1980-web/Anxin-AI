# AI法务智能体系统 - 后端开发 Dockerfile
# 支持 uvicorn --reload 热重载，修改 Python 代码后自动重启

FROM python:3.11-slim-bookworm

WORKDIR /app

# 系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 安装 uv（更快的 pip）
RUN pip install uv -i https://mirrors.aliyun.com/pypi/simple/ --trusted-host mirrors.aliyun.com

# 安装 Python 依赖（利用 Docker 缓存层）
COPY pyproject.toml README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=cache,target=/root/.cache/pip \
    uv pip install --system -e .

# 源代码通过 volume 挂载，无需 COPY
RUN mkdir -p /app/data

EXPOSE 8001

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -sf http://localhost:8001/health || exit 1

CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8001", "--reload", "--reload-dir", "src"]
